# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=

# Google AI Studio / Gemini API
GOOGLE_API_KEY=

# Model id (dış ajan + browser-use; öneri: gemini-2.5-flash — Gemini 3 ile interrupt sonrası thought_signature uyumu için langchain-google-genai>=4.2 gerekir)
GEMINI_MODEL=gemini-2.5-flash

# Tarayıcı: yerelde görmek için false, Docker için true
PLAYWRIGHT_HEADLESS=false

# LangGraph checkpoint (sqlite)
CHECKPOINT_PATH=./data/checkpoints.db

# browser-use Agent
BROWSER_MAX_STEPS=35
BROWSER_STEP_TIMEOUT=180

# Gezinme hazırlık bekleme (sn); kütüphane çapraz alan varsayılanı 8 — yavaş sayfalar için 15–25 önerilir
BROWSER_NAV_READINESS_TIMEOUT=18

# true: tüm köken iframe'ler (varsayılan). false: CDP/ax_tree yarışını azaltabilir, bazı sitelerde eksik DOM riski
BROWSER_CROSS_ORIGIN_IFRAMES=true

# Sayfa yükü / eylem arası bekleme (sn) — kararlılık için hafif artırılmış varsayılanlar
BROWSER_MINIMUM_WAIT_PAGE_LOAD_TIME=0.28
BROWSER_WAIT_FOR_NETWORK_IDLE_PAGE_LOAD_TIME=0.55
BROWSER_WAIT_BETWEEN_ACTIONS=0.15

# Konsol loglarında Telegram bot URL token maskeleme (false: sadece httpx WARNING; yine de token başka yerde görünebilir)
LOG_REDACT_TELEGRAM_TOKEN=true

# Opsiyonel: browser-use log seviyesi
BROWSER_USE_SETUP_LOGGING=true
