# ── Uygulama ──
ENVIRONMENT=development         # development | production
LOG_LEVEL=DEBUG                 # DEBUG | INFO | WARNING | ERROR

# ── Telegram ──
# BotFather'dan aldığın token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=           # Üretim ortamında https://domain.com/webhook
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# ── LLM ──
ANTHROPIC_API_KEY=              # İsteğe bağlı
OPENAI_API_KEY=                 # İsteğe bağlı
GOOGLE_API_KEY=your_google_gemini_api_key_here
AGENT_LLM_PROVIDER=google       # google | openai | anthropic
AGENT_LLM_MODEL=gemini-3.1-flash-lite-preview
VISION_LLM_MODEL=gemini-3.1-flash-lite-preview

# ── Veritabanı ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ghostattend
POSTGRES_USER=ghostadmin
POSTGRES_PASSWORD=your_secure_db_password_here
# URL formatı: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://ghostadmin:password@postgres/ghostattend

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
# URL formatı: redis://:password@host:port/db
REDIS_URL=redis://:password@redis:6379/0

# ── Güvenlik ──
# Kullanıcı verilerini şifrelemek için 32-byte base64 encoded Fernet anahtarı
MASTER_ENCRYPTION_KEY=your_fernet_master_key_here

# ── Agent ──
BROWSER_HEADLESS=true           # Docker/VPS ortamında her zaman true olmalı
AGENT_TIMEOUT_SECONDS=3600
AGENT_MAX_RETRY=3
MEETING_START_OFFSET_MINUTES=5  # Dersten kaç dakika önce hazırlık başlasın

# ── Screenshot ──
SCREENSHOT_STORAGE=local        # local | s3
SCREENSHOT_DIR=/app/screenshots