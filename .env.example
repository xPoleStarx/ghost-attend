# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite-preview
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=

# Database
DATABASE_URL=postgresql+asyncpg://ghost:ghost@db:5432/ghost_attend

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SECRET_KEY_VERSION=v1

# Browser
BROWSER_HEADLESS=true
PLAYWRIGHT_EXECUTABLE_PATH=
PAGE_TIMEOUT=30000
MAX_RETRIES=3
MAX_TOOL_TIMEOUT=60
SCREENSHOT_DIR=/tmp/ghost-attend/screenshots

# Scheduler / Worker
WORKER_CONCURRENCY=4
DEFAULT_TIMEZONE=Europe/Istanbul
LOGIN_FAILURE_COOLDOWN_SECONDS=300
HUMAN_INPUT_TIMEOUT_SECONDS=300
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
